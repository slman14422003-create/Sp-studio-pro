<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="72dp">

            <!-- أزرار تبديل الأوضاع -->
            <LinearLayout
                android:id="@+id/topModes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp" />

            <!-- بطاقة المعاينة القابلة للتصدير -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#08FFFFFF"
                android:padding="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/aspectFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/exportArea"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_export_card"
                        android:orientation="vertical"
                        android:padding="20dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <!-- العنوان -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <View
                                android:id="@+id/titleBorder"
                                android:layout_width="5dp"
                                android:layout_height="match_parent"
                                android:background="@color/accent_blue" />

                            <EditText
                                android:id="@+id/titleEdit"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:gravity="top|start"
                                android:hint="@string/hint_title"
                                android:inputType="textMultiLine"
                                android:paddingStart="12dp"
                                android:textColor="@color/accent_blue"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- نص البطاقة القابل للتحرير -->
                        <EditText
                            android:id="@+id/bodyEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="top|start"
                            android:hint="@string/hint_body"
                            android:inputType="textMultiLine"
                            android:lineSpacingMultiplier="1.75"
                            android:textColor="@color/body_dark"
                            android:textSize="16sp" />

                        <!-- نسخة معروضة فقط عند تفعيل تلوين الكلمات -->
                        <TextView
                            android:id="@+id/bodyColorized"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.75"
                            android:textColor="@color/body_dark"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <!-- جدول المقارنة (إيجابيات/سلبيات) -->
                        <LinearLayout
                            android:id="@+id/comparisonContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="#0D000000"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingBottom="10dp"
                                android:text="@string/comparison_title"
                                android:textColor="@color/dr_name_dark"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:background="#0D000000"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/pros_title"
                                        android:textColor="@color/accent_green"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:id="@+id/prosList"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical" />

                                    <TextView
                                        android:id="@+id/addProsBtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/bg_add_dashed"
                                        android:gravity="center"
                                        android:padding="8dp"
                                        android:text="@string/add_pro"
                                        android:textColor="@color/text_muted"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="#0D000000"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/cons_title"
                                        android:textColor="@color/accent_red"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:id="@+id/consList"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical" />

                                    <TextView
                                        android:id="@+id/addConsBtn"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:background="@drawable/bg_add_dashed"
                                        android:gravity="center"
                                        android:padding="8dp"
                                        android:text="@string/add_con"
                                        android:textColor="@color/text_muted"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:padding="8dp"
                                android:text="@string/hint_compare_edit"
                                android:textColor="@color/dr_name_dark"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- التذييل -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <EditText
                                    android:id="@+id/drNameEdit"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:hint="@string/hint_dr_name"
                                    android:inputType="text"
                                    android:textColor="@color/dr_name_dark"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/drSubEdit"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:hint="@string/hint_dr_sub"
                                    android:inputType="text"
                                    android:textColor="@color/accent_blue"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/logoIcon"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="#14000000"
                                android:gravity="center"
                                android:text="SP"
                                android:textColor="#14000000"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- شريط الإجراءات -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSavePng"
                    style="@style/GlassPillButton"
                    android:background="@drawable/bg_pill_success"
                    android:text="@string/btn_save_png" />

                <TextView
                    android:id="@+id/btnCheckUpdates"
                    style="@style/GlassPillButton"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_glass_pill"
                    android:text="@string/btn_check_updates" />
            </LinearLayout>

            <!-- لوحة الخصائص -->
            <LinearLayout
                android:id="@+id/smartPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/PanelSectionLabel"
                    android:text="@string/label_aspect" />

                <LinearLayout
                    android:id="@+id/aspectRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/PanelSectionLabel"
                    android:text="@string/label_text_editing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SliderLabel"
                        android:text="@string/label_title_size" />

                    <SeekBar
                        android:id="@+id/seekTitleSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="24"
                        android:progress="12" />

                    <TextView
                        android:id="@+id/labelTitleSizeVal"
                        style="@style/ValueChip"
                        android:text="30" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SliderLabel"
                        android:text="@string/label_body_size" />

                    <SeekBar
                        android:id="@+id/seekBodySize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="12"
                        android:progress="4" />

                    <TextView
                        android:id="@+id/labelBodySizeVal"
                        style="@style/ValueChip"
                        android:text="16" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SliderLabel"
                        android:text="@string/label_line_height" />

                    <SeekBar
                        android:id="@+id/seekLineHeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="16"
                        android:progress="11" />

                    <TextView
                        android:id="@+id/labelLineHeightVal"
                        style="@style/ValueChip"
                        android:text="1.75" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SliderLabel"
                        android:text="@string/label_font" />

                    <Spinner
                        android:id="@+id/spinnerFont"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- لوحة الأدوات -->
            <LinearLayout
                android:id="@+id/toolsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_panel_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/PanelSectionLabel"
                    android:text="@string/label_colors" />

                <LinearLayout
                    android:id="@+id/colorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/PanelSectionLabel"
                    android:text="@string/label_ai_tools" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnColorize"
                        style="@style/GlassPillButtonSmall"
                        android:text="@string/btn_colorize_on" />

                    <TextView
                        android:id="@+id/btnResetColors"
                        style="@style/GlassPillButtonSmall"
                        android:layout_marginStart="8dp"
                        android:text="@string/btn_reset_colors" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wordCounter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#66000000"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/word_counter_format"
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnResetAll"
                    style="@style/GlassPillButtonSmall"
                    android:layout_width="match_parent"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_primary"
                    android:text="@string/btn_reset_all" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:text="@string/hint_colorize"
                    android:textColor="@color/text_light"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- شريط الحالة -->
            <TextView
                android:id="@+id/statusBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#66000000"
                android:gravity="center"
                android:padding="8dp"
                android:text="🔄"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- الشريط العلوي الزجاجي الثابت -->
    <LinearLayout
        android:id="@+id/glassNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_glass_navbar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnTogglePanel"
            style="@style/GlassPillButtonSmall"
            android:text="@string/btn_toggle_panel" />

        <TextView
            android:id="@+id/btnToggleTools"
            style="@style/GlassPillButtonSmall"
            android:layout_marginStart="8dp"
            android:text="@string/btn_toggle_tools" />

        <TextView
            android:id="@+id/btnShare"
            style="@style/GlassPillButtonSmall"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_primary"
            android:text="@string/btn_share" />

        <TextView
            android:id="@+id/btnHelp"
            style="@style/GlassPillButtonSmall"
            android:layout_marginStart="8dp"
            android:text="@string/btn_help" />
    </LinearLayout>

</FrameLayout>
